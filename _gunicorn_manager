#!/bin/bash

# ============================================================================
# This script is used to start/stop/restart the FLASK APIs in deployment
# ============================================================================

# Load vars defined in .env
source .env

PORT=$API_PORT
PID_FILE=".pid.txt"
OLD_PID_FILE="${PID_FILE}.oldbin"
# NOTE: Fallback process detection relies on Gunicorn being able to rename its
# processes to `gunicorn: master|worker [APP_NAME]`, which requires the optional
# `setproctitle` dependency to be installed in the virtual environment.

# Default to foreground; allow `-d` (daemonize) as optional 2nd arg
is_daemon=FALSE
is_daemon_flag=''
if [[ $2 == "-d" ]]; then
    is_daemon=TRUE
    is_daemon_flag='--daemon'
fi

# Count how many gunicorn processes are running from this virtual environment:
if [ -z $VIRTUAL_ENV ]; then
    echo "No VENV activated!"
    exit 1
fi

read_pid_file() {
    local file="$1"
    if [ -e "$file" ]; then
        cat "$file" 2>/dev/null
    fi
}

pid_is_running() {
    local pid="$1"
    [[ -n $pid ]] && ps -p "$pid" >/dev/null 2>&1
}

current_master_pid() {
    local pid
    pid=$(read_pid_file "$PID_FILE")
    if pid_is_running "$pid"; then
        echo "$pid"
    fi
}

fallback_master_pids() {
    # Requires setproctitle to be installed.
    pgrep -f "gunicorn: master \[$APP_NAME\]" 2>/dev/null || true
}

detect_new_master() {
    local old_master="$1"
    local retries=${2:-40}
    local delay=${3:-0.5}
    local i=0
    local candidate

    while [[ $i -lt $retries ]]; do
        candidate=$(read_pid_file "$PID_FILE")
        if [[ -n $candidate && $candidate != "$old_master" ]]; then
            if pid_is_running "$candidate"; then
                echo "$candidate"
                return 0
            fi
        fi

        for candidate in $(fallback_master_pids); do
            if [[ -n $candidate && $candidate != "$old_master" ]]; then
                if pid_is_running "$candidate"; then
                    echo "$candidate"
                    return 0
                fi
            fi
        done

        sleep "$delay"
        i=$((i + 1))
    done

    return 1
}

count_workers() {
    local count=0
    local master_pid

    master_pid=$(current_master_pid)
    if [[ -n $master_pid ]]; then
        count=$(pgrep -P "$master_pid" | wc -l | tr -d ' ')
    fi

    if [[ ${count:-0} -eq 0 ]]; then
        # Fallback only works when setproctitle is installed.
        count=$(pgrep -f "gunicorn: worker \[$APP_NAME\]" 2>/dev/null | wc -l | tr -d ' ')
    fi

    echo "${count:-0}"
}

count_workers_for_master() {
    local master_pid="$1"
    if [[ -z $master_pid ]]; then
        echo 0
        return
    fi
    pgrep -P "$master_pid" 2>/dev/null | wc -l | tr -d ' '
}

wait_for_pid_exit() {
    local pid="$1"
    local retries=${2:-20}
    local delay=${3:-0.5}
    local i=0

    while [[ $i -lt $retries ]]; do
        if ! pid_is_running "$pid"; then
            return 0
        fi
        sleep "$delay"
        i=$((i + 1))
    done

    return 1
}

wait_for_file() {
    local file="$1"
    local retries=${2:-20}
    local delay=${3:-0.5}
    local i=0
    while [[ $i -lt $retries ]]; do
        if [ -e "$file" ]; then
            return 0
        fi
        sleep "$delay"
        i=$((i + 1))
    done
    return 1
}

d_status() {

    local worker_count
    worker_count=$(count_workers)
    echo "$worker_count worker(s) detected."

    if [[ $worker_count -gt 0 ]]; then
        echo "Gunicorn is running with "$worker_count" workers."
        echo "Listening on 127.0.0.1:$PORT"
        local parent_pid
        parent_pid=$(current_master_pid)
        if [[ -n $parent_pid ]]; then
            echo "Parent PID: $parent_pid"
        else
            local master_pids
            master_pids=$(fallback_master_pids)
            if [[ -n $master_pids ]]; then
                echo "Parent PID file missing; detected master PID(s): $master_pids"
            else
                echo "Parent PID file missing and no master detected."
            fi
        fi
    else
        echo "No gunicorn process is running from this project's virtual environment at the moment."
    fi
}

d_start() {

    if [[ $(count_workers) -gt 0 ]]; then
        d_status
        echo "Cancelling start!"
    else
        ### Enter src, start gunicorn, exit
        echo "-----------------------------------------------------"
        echo "This API is not running; begin workers in production!"
        IS_DAEMON=$is_daemon gunicorn src.api.app:app \
            --worker-class uvicorn.workers.UvicornWorker \
            --config .gunicorn.config.py \
            --pid "$PID_FILE" \
            --name $APP_NAME \
            --bind '127.0.0.1:'$PORT \
            $is_daemon_flag
        echo "-----------------------------------------------------"
    fi
}

d_stop() {
    local worker_count master_pids master_pid master_pid_from_file
    worker_count=$(count_workers)
    master_pids=$(fallback_master_pids)
    master_pid_from_file=$(current_master_pid)

    if [[ -n $master_pid_from_file ]]; then
        archive_logs
        echo "Stopping gunicorn process; this may take ~10 seconds..."
        master_pid=$master_pid_from_file
        kill -s QUIT "$master_pid"
        if ! wait_for_pid_exit "$master_pid"; then
            echo "Master still running; sending SIGKILL..."
            kill -9 "$master_pid"
            wait_for_pid_exit "$master_pid"
        fi
        rm -f "$PID_FILE" "$OLD_PID_FILE"
        echo "... done!"
    elif [[ -n $master_pids || $worker_count -gt 0 ]]; then
        echo "PID file missing, but gunicorn appears to be running (master PID(s): ${master_pids:-unknown})."
        if [[ -n $master_pids ]]; then
            echo "Attempting graceful shutdown..."
            for pid in $master_pids; do
                kill -s QUIT "$pid"
                if ! wait_for_pid_exit "$pid" 10 0.5; then
                    echo "Master PID $pid persisted; sending SIGKILL..."
                    kill -9 "$pid"
                    wait_for_pid_exit "$pid" 10 0.5 || true
                fi
            done
        else
            echo "Unable to locate master PID automatically; please stop processes manually if they persist."
        fi
        if [[ $(count_workers) -gt 0 ]]; then
            echo "Workers still detected; please investigate manually."
        else
            echo "Gunicorn appears to have stopped."
        fi
    else
        echo "No gunicorn master or workers detected."
    fi
}

d_restart() {

    local old_master new_master
    old_master=$(current_master_pid)

    if [[ -z $old_master ]]; then
        echo "No running master detected; attempting fresh start..."
        d_start
        return
    fi

    archive_logs

    echo "Requesting zero-downtime reload (USR2) for master PID $old_master..."
    if ! kill -s USR2 "$old_master" 2>/dev/null; then
        echo "Failed to signal master; aborting restart."
        return 1
    fi

    if ! new_master=$(detect_new_master "$old_master" 60 0.5); then
        echo "New master PID not detected; leaving old master running."
        return 1
    fi

    echo "New master PID detected: $new_master"
    echo "Waiting for new workers to come online..."
    for _ in {1..40}; do
        if [[ $(count_workers) -gt 0 ]]; then
            break
        fi
        sleep 0.5
    done

    echo "Telling old master $old_master to stop accepting new connections (WINCH)..."
    kill -s WINCH "$old_master" 2>/dev/null || true
    for _ in {1..20}; do
        if [[ $(count_workers_for_master "$old_master") -eq 0 ]]; then
            break
        fi
        sleep 0.5
    done

    echo "Gracefully shutting down old master $old_master (QUIT)..."
    kill -s QUIT "$old_master" 2>/dev/null || true
    if ! wait_for_pid_exit "$old_master" 40 0.5; then
        echo "Old master still running; sending SIGKILL..."
        kill -9 "$old_master" 2>/dev/null || true
        wait_for_pid_exit "$old_master" 20 0.5 || true
    fi

    rm -f "$OLD_PID_FILE"

    d_status
}

d_kill() {
    echo "Forcefully terminating any stray gunicorn workers..."
    if pkill -TERM -f 'gunicorn: worker'; then
        echo "pkill issued successfully. Verify processes with 'ps' if needed."
    else
        echo "pkill did not match any processes."
    fi
}

archive_logs() {
    if [ -e logging/production_logs.log ]; then
        printf "\n\nArchiving previous logs..."
        # sleep 1
        cp logging/production_logs.log logging/old-logs/productions_logs_last.log
        mv logging/production_logs.log $(x="logging/old-logs/production_logs_"$(date)"_.log" && echo ${x//" "/"_"})
        printf " done.\n"
    fi
}

case $1 in
status)
    d_status
    ;;
start)
    d_start
    ;;
stop)
    d_stop
    ;;
restart)
    d_restart
    ;;
kill)
    d_kill
    ;;
*)
    echo "usage: $0 {status|start|stop|restart|kill}"
    exit 1
    ;;
esac

exit 0
