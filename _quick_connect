#!/usr/bin/env bash
set -euo pipefail

# Helper to open a psql session using credentials from an .env-style file.

print_usage() {
  cat <<'EOF'
Usage: ./_quick_connect [--env PATH] [psql arguments...]

Options:
  -e, --env PATH   Path to the env file to load (default: .env)
  -h, --help       Show this help message

Any additional arguments are forwarded to psql, e.g.:
  ./_quick_connect --env .env -- \\
    --command "SELECT now();"
EOF
}

ENV_FILE=".env"
PSQL_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -e|--env)
      if [[ $# -lt 2 ]]; then
        echo "Error: missing path after $1" >&2
        exit 1
      fi
      ENV_FILE="$2"
      shift 2
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    --)
      shift
      PSQL_ARGS+=("$@")
      break
      ;;
    *)
      PSQL_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Env file not found: $ENV_FILE" >&2
  exit 1
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "psql command not found; install PostgreSQL client utilities first." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$ENV_FILE"

DB_DIALECT_VALUE="${DB_DIALECT:-}"
if [[ "$DB_DIALECT_VALUE" != "postgresql" && "$DB_DIALECT_VALUE" != "postgres" ]]; then
  echo "Unsupported DB_DIALECT '${DB_DIALECT_VALUE}' (expected 'postgresql' or 'postgres')." >&2
  exit 1
fi

: "${DB_HOST:?Missing DB_HOST in $ENV_FILE}"
: "${DB_USERNAME:?Missing DB_USERNAME in $ENV_FILE}"
: "${DB_PASSWORD:?Missing DB_PASSWORD in $ENV_FILE}"
: "${DB_DATABASE:?Missing DB_DATABASE in $ENV_FILE}"

DB_PORT_VALUE="${DB_PORT:-5432}"
if [[ ! "$DB_PORT_VALUE" =~ ^[0-9]+$ ]]; then
  echo "Invalid DB_PORT '$DB_PORT_VALUE' (expected numeric)." >&2
  exit 1
fi

PGPASSWORD="$DB_PASSWORD" \
  psql \
    --host="$DB_HOST" \
    --port="$DB_PORT_VALUE" \
    --username="$DB_USERNAME" \
    --dbname="$DB_DATABASE" \
    "${PSQL_ARGS[@]}"
